{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "PerSecondCapacity": 20,
    "PerSecondRefill": 20,
    "FallbackRefill": 5,
    "BucketTtlSeconds": 120,
    "DailySetTtlSeconds": 90000,
    "InteractiveMaxWaitMs": 2000,
    "CampaignWaitCapMs": 750
  }
}
