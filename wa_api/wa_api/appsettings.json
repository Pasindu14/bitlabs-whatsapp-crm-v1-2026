{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "PerSecondCapacity": 20,
    "PerSecondRefill": 20,
    "FallbackRefill": 5,
    "BucketTtlSeconds": 120,
    "DailySetTtlSeconds": 90000,
    "InteractiveMaxWaitMs": 2000,
    "CampaignWaitCapMs": 750
  },
  // Plan 005 — the chatbot. Enabled is the platform master switch and ships OFF: with it off the webhook
  // hands nothing to the bot and the CRM behaves exactly as it did before the chatbot was merged in.
  // Turn it on per environment with the Bot__Enabled environment variable.
  "Bot": {
    "Enabled": false,
    "GateCacheSeconds": 30,
    "CampaignContextDays": 7,
    "MaxReplyAgeMinutes": 15
  },
  // The chatbot runs on its own Hangfire queue ("bot") with its own workers, so it cannot take a worker
  // from campaigns or webhooks. 0 disables the bot workers entirely.
  "Hangfire": {
    "BotWorkerCount": 2
  },
  // AI cost tracking. USD per million tokens, from platform.claude.com/docs/en/about-claude/pricing.
  // A model missing here still replies; its log rows just have no cost. The API key is NOT set here:
  // use the Anthropic__ApiKey environment variable (or user-secrets locally). No key = AI stays off and
  // keyword rules still reply.
  "Anthropic": {
    "Pricing": {
      "claude-haiku-4-5": { "Input": 1.00, "Output": 5.00, "CacheWrite5m": 1.25, "CacheRead": 0.10 },
      "claude-sonnet-5-5": { "Input": 2.00, "Output": 10.00, "CacheWrite5m": 2.50, "CacheRead": 0.20 },
      "claude-opus-5-5": { "Input": 4.00, "Output": 20.00, "CacheWrite5m": 5.00, "CacheRead": 0.20 }
    }
  },
  // Meta rate card, USD per delivered message, keyed by the RECIPIENT's calling code.
  // Service = utility rate from 2026-10-01. Marketing is set to the highest published UAE figure until
  // it is confirmed against Meta's official AED rate card. Default applies to unlisted countries.
  "Meta": {
    "Pricing": {
      "Countries": {
        "971": { "Marketing": 0.0499, "Utility": 0.0157, "Authentication": 0.0157, "Service": 0.0157 }
      },
      "Default": { "Marketing": 0.0499, "Utility": 0.0157, "Authentication": 0.0157, "Service": 0.0157 }
    }
  },
  "Billing": {
    // Display only: costs are stored in USD, plan prices are in AED.
    "UsdToAed": 3.6725
  }
}
